#!/bin/bash -eux

VER=34.0.5
SHA256=d077fdca3dc78ef60b5bbc51182f2a1737aa01e2044d6c23f4e7b72146f5239a

dl() {
    local proxy_args=()
    [ -n "${FAB_HTTP_PROXY:-}" ] && proxy_args=(--proxy "$FAB_HTTP_PROXY")
    cd "$2"
    curl --proto '=https' --tlsv1.2 -L -f "${proxy_args[@]}" "$1" >"$3"
    cd -
}

URL="https://download.nextcloud.com/server/releases/nextcloud-${VER}.zip"

dl "$URL" /usr/local/src "nextcloud-$VER.zip"
echo "$SHA256  /usr/local/src/nextcloud-$VER.zip" \
    | sha256sum --check --strict
