#!/bin/bash -ex

DB_NAME=nextcloud
DB_USER=nextcloud
DB_PASS=$(mcookie)
ADMIN_NAME="admin"
ADMIN_PASS=$(mcookie)

WEBROOT=/var/www/nextcloud
DATAROOT=${WEBROOT}-data
CONF=$WEBROOT/config/config.php
VER=34.0.0
ARCHIVE=/usr/local/src/nextcloud-${VER}.zip

# unpack tarball to webroot and set permissions
unzip "$ARCHIVE" -d "$(dirname "$WEBROOT")"
[[ ! -d "$WEBROOT" ]] && exit 1
rm -f "$ARCHIVE"
mkdir -p "$DATAROOT" "$WEBROOT/custom_apps"

# feedback funcs
error() { echo "ERROR: $*" >&2; exit 1; }
success() { echo "SUCCESS: $*"; }

# configure php

sed -i 's/^\(opcache.interned_strings_buffer\) *=.*$/\1 = 32/' /etc/php/8.?/apache2/php.ini

# configure apache
a2dissite 000-default
a2ensite nextcloud.conf
a2enmod rewrite
a2enmod headers
a2enmod env
a2enmod dir
a2enmod mime
a2dismod evasive # nextcloud includes it's own rate limiting & mod-evasive causes issues with certain user configurations see #2044

# start services
service mysql start
service apache2 start

# setup the database
mysqladmin create $DB_NAME
mysql --batch --execute "grant all privileges on $DB_NAME.* to $DB_USER@localhost identified by '$DB_PASS'; flush privileges;"

# command-line install
chown -R www-data:www-data $WEBROOT $DATAROOT
cd $WEBROOT
turnkey-occ maintenance:install --database "mysql" \
    --database-name "$DB_NAME"  --database-user "$DB_USER" --database-pass "$DB_PASS" \
    --admin-user "$ADMIN_NAME" --admin-pass "$ADMIN_PASS" \
    --data-dir "$DATAROOT" 

turnkey-occ maintenance:repair --include-expensive
turnkey-occ db:add-missing-indices
turnkey-occ theming:config slogan "Powered by TurnKey Linux"
turnkey-occ theming:config url https://www.turnkeylinux.org/nextcloud
turnkey-occ theming:config name "NextCloud Appliance"
turnkey-occ maintenance:mode --off

# adjust nextcloud config for redis
sed -i '/^);/d' $CONF
cat >> $CONF <<EOF
  'memcache.local' => '\OC\Memcache\Redis',
  'redis' => array(
      'host' => '/var/run/redis/redis.sock',
      'port' => 0,
      'timeout' => 0.0
  ),
  'filelocking.enabled' => true,
  'memcache.locking' => '\OC\Memcache\Redis',
  'apps_paths' => array(
    array(
      'path' => '/var/www/nextcloud/apps',
      'url' => '/apps',
      'writable' => false,
    ),
    array(
      'path' => '/var/www/nextcloud/custom_apps',
      'url' => '/custom_apps',
      'writable' => true,
    ),
  ),
  'log_type' => 'file',
  'logfile' => '/var/www/nextcloud-data/nextcloud.log',
  'loglevel' => 3
);
EOF

# add www-data user to redis group
usermod -a -G redis www-data

# adjust redis config
sed -i 's|# unixsocket .*|unixsocket /var/run/redis/redis.sock|g' /etc/redis/redis.conf
sed -i 's|# unixsocketperm .*|unixsocketperm 770|g' /etc/redis/redis.conf

# Root owns Nextcloud core, bundled apps, and configuration. The web service
# retains only data and the explicit custom-app management boundary.
chown -R root:root "$WEBROOT"
find "$WEBROOT" -type d -exec chmod 0755 {} +
find "$WEBROOT" -type f -exec chmod 0644 {} +
chown -R www-data:www-data "$DATAROOT" "$WEBROOT/custom_apps"
chown root:www-data "$CONF"
chmod 0640 "$CONF"

# stop services
service mysql stop
service apache2 stop
