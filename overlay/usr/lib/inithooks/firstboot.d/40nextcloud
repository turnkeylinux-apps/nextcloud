#!/bin/bash -e
# set nextcloud admin password and domain to serve

. /etc/default/inithooks

[ -e $INITHOOKS_CONF ] && . $INITHOOKS_CONF
systemctl start mariadb.service
printf '%s\n' "$APP_PASS" | \
    $INITHOOKS_PATH/bin/nextcloud.py --pass-stdin --domain="$APP_DOMAIN"

# Nextcloud rejects a protected config.php unless the merged configuration
# explicitly declares that it is intentionally read-only.
install -o root -g www-data -m 0640 /dev/stdin \
    /var/www/nextcloud/config/turnkey-read-only.config.php <<'EOF'
<?php
$CONFIG = array(
    'config_is_read_only' => true,
);
EOF

# Check the exact configuration-fragment boundary separately from later
# generic firstboot hooks. Keep the credential on stdin and fail closed.
printf '%s\n' "$APP_PASS" | runuser -u www-data -- /usr/bin/php -r '
define("OC_CONSOLE", 1);
require_once "/var/www/nextcloud/lib/base.php";
$password = rtrim(stream_get_contents(STDIN), "\r\n");
exit(\OCP\Server::get(\OCP\IUserManager::class)
    ->checkPassword("admin", $password) === false ? 1 : 0);
'
echo '[nextcloud-auth-check] credential accepted after read-only fragment'

# Temporary acceptance trace: retain keyed fingerprints only, so the late
# firstboot and runtime checkpoints can detect credential or hash mutation
# without persisting or emitting either value.
diagnostic_state=/run/tkl-nextcloud-auth-state
diagnostic_key=$(openssl rand -hex 32)
fingerprint() {
    openssl dgst -sha256 -mac HMAC -macopt "hexkey:$diagnostic_key" -r |
        awk '{print $1}'
}
firstboot_password_fingerprint=$(printf '%s' "$APP_PASS" | fingerprint)
firstboot_hash=$(
    runuser -u www-data -- /usr/bin/php -r '
define("OC_CONSOLE", 1);
require_once "/var/www/nextcloud/lib/base.php";
$user = \OCP\Server::get(\OCP\IUserManager::class)->get("admin");
echo $user?->getPasswordHash() ?? "";
'
)
firstboot_hash_fingerprint=$(printf '%s' "$firstboot_hash" | fingerprint)
install -o root -g root -m 0600 /dev/stdin "$diagnostic_state" <<EOF
diagnostic_key=$diagnostic_key
firstboot_password_fingerprint=$firstboot_password_fingerprint
firstboot_hash_fingerprint=$firstboot_hash_fingerprint
EOF
unset diagnostic_key firstboot_password_fingerprint firstboot_hash \
    firstboot_hash_fingerprint
