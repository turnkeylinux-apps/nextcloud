#!/bin/bash -e
# set nextcloud admin password and domain to serve

. /etc/default/inithooks

[ -e $INITHOOKS_CONF ] && . $INITHOOKS_CONF
systemctl start mariadb.service
printf '%s\n' "$APP_PASS" | \
    $INITHOOKS_PATH/bin/nextcloud.py --pass-stdin --domain="$APP_DOMAIN"

# Nextcloud rejects a protected config.php unless the merged configuration
# explicitly declares that it is intentionally read-only.
install -o root -g www-data -m 0640 /dev/stdin \
    /var/www/nextcloud/config/turnkey-read-only.config.php <<'EOF'
<?php
$CONFIG = array(
    'config_is_read_only' => true,
);
EOF
