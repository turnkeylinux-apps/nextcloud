#!/bin/bash -e
# Temporary acceptance trace: prove whether later firstboot hooks mutate the
# Nextcloud administrator credential or stored password hash.

. /etc/default/inithooks
[ -e "$INITHOOKS_CONF" ] && . "$INITHOOKS_CONF"
. /run/tkl-nextcloud-auth-state

fingerprint() {
    openssl dgst -sha256 -mac HMAC -macopt "hexkey:$diagnostic_key" -r |
        awk '{print $1}'
}

late_password_fingerprint=$(printf '%s' "$APP_PASS" | fingerprint)
test "$late_password_fingerprint" = "$firstboot_password_fingerprint"
printf '%s\n' "$APP_PASS" | runuser -u www-data -- /usr/bin/php -r '
define("OC_CONSOLE", 1);
require_once "/var/www/nextcloud/lib/base.php";
$password = rtrim(stream_get_contents(STDIN), "\r\n");
exit(\OCP\Server::get(\OCP\IUserManager::class)
    ->checkPassword("admin", $password) === false ? 1 : 0);
'
late_hash=$(
    runuser -u www-data -- /usr/bin/php -r '
define("OC_CONSOLE", 1);
require_once "/var/www/nextcloud/lib/base.php";
$user = \OCP\Server::get(\OCP\IUserManager::class)->get("admin");
echo $user?->getPasswordHash() ?? "";
'
)
late_hash_fingerprint=$(printf '%s' "$late_hash" | fingerprint)
test "$late_hash_fingerprint" = "$firstboot_hash_fingerprint"
echo '[nextcloud-auth-check] credential and hash unchanged through late firstboot'

unset diagnostic_key firstboot_password_fingerprint \
    firstboot_hash_fingerprint late_password_fingerprint late_hash \
    late_hash_fingerprint
