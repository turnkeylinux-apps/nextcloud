#!/bin/bash -e

[[ -z "$DEBUG" ]] || set -x

OCC=/var/www/nextcloud/occ
OCC_CONFIG=/var/www/nextcloud/config/config.php

if [[ -z "$NC_USR" ]]; then
    if [[ -e "$OCC_CONFIG" ]]; then
        NC_USR=$(stat --format='%U' "$OCC_CONFIG")
    else
        NC_USR=www-data
    fi
fi

COMMAND="/usr/bin/php $OCC $(printf '%q ' "$@")"

runuser "$NC_USR" -s /bin/bash -c "$COMMAND"
