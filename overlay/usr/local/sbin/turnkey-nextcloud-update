#!/bin/bash
set -euo pipefail

WEBROOT=/var/www/nextcloud
DATAROOT=/var/www/nextcloud-data
CONF=$WEBROOT/config/config.php
READ_ONLY_CONF=$WEBROOT/config/turnkey-read-only.config.php
READ_ONLY_CONF_DISABLED=/var/www/.turnkey-nextcloud-read-only.config.php.disabled

disable_read_only_config() {
    test -f "$READ_ONLY_CONF"
    test ! -e "$READ_ONLY_CONF_DISABLED"
    mv -- "$READ_ONLY_CONF" "$READ_ONLY_CONF_DISABLED"
}

restore_read_only_config() {
    if test -e "$READ_ONLY_CONF_DISABLED"; then
        mv -f -- "$READ_ONLY_CONF_DISABLED" "$READ_ONLY_CONF"
    fi
}

restore_permissions() {
    restore_read_only_config
    chown -R root:root "$WEBROOT"
    find "$WEBROOT" -type d -exec chmod 0755 {} +
    find "$WEBROOT" -type f -exec chmod 0644 {} +
    install -d -o www-data -g www-data -m 0755 "$WEBROOT/custom_apps"
    chown -R www-data:www-data "$DATAROOT" "$WEBROOT/custom_apps"
    chown root:www-data "$CONF" "$READ_ONLY_CONF"
    chmod 0640 "$CONF" "$READ_ONLY_CONF"
}

main() {
    test "$(id -u)" -eq 0 || {
        echo "turnkey-nextcloud-update must run as root" >&2
        exit 1
    }

    trap restore_permissions EXIT
    disable_read_only_config
    chown -R www-data:www-data "$WEBROOT"
    runuser www-data -s /bin/bash -c \
        "/usr/bin/php '$WEBROOT/updater/updater.phar' --no-interaction"
    runuser www-data -s /bin/bash -c \
        "/usr/bin/php '$WEBROOT/occ' upgrade --no-interaction"
    runuser www-data -s /bin/bash -c \
        "/usr/bin/php '$WEBROOT/occ' integrity:check-core"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
