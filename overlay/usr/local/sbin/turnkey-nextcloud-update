#!/bin/bash
set -euo pipefail

WEBROOT=/var/www/nextcloud
DATAROOT=/var/www/nextcloud-data
LEGACY_READ_ONLY_DISABLED=/var/www/.turnkey-nextcloud-read-only.config.php.disabled
remove_legacy_read_only_config() {
    local path
    for path in "$WEBROOT/config/turnkey-read-only.config.php" \
        "$LEGACY_READ_ONLY_DISABLED"; do
        if test -f "$path" && cmp -s "$path" <(cat <<'PHP'
<?php
$CONFIG = array(
    'config_is_read_only' => true,
);
PHP
        ); then
            rm -- "$path"
        fi
    done
}

restore_permissions() {
    /usr/local/sbin/turnkey-nextcloud-config-permissions
    find -P "$WEBROOT" \( -path "$WEBROOT/config" -o -path "$WEBROOT/custom_apps" \) -prune -o \
        -exec chown -h root:root {} +
    find -P "$WEBROOT" \( -path "$WEBROOT/config" -o -path "$WEBROOT/custom_apps" \) -prune -o \
        -type d -exec chmod 0755 {} +
    find -P "$WEBROOT" \( -path "$WEBROOT/config" -o -path "$WEBROOT/custom_apps" \) -prune -o \
        -type f -exec chmod 0644 {} +
    chown -hR www-data:www-data "$DATAROOT" "$WEBROOT/custom_apps"
    /usr/local/sbin/turnkey-nextcloud-config-permissions
}

main() {
    test "$(id -u)" -eq 0 || {
        echo "turnkey-nextcloud-update must run as root" >&2
        exit 1
    }

    trap restore_permissions EXIT
    /usr/local/sbin/turnkey-nextcloud-config-permissions
    remove_legacy_read_only_config
    find -P "$WEBROOT" -path "$WEBROOT/config" -prune -o \
        -exec chown -h www-data:www-data {} +
    runuser www-data -s /bin/bash -c \
        "/usr/bin/php '$WEBROOT/updater/updater.phar' --no-interaction"
    runuser www-data -s /bin/bash -c \
        "/usr/bin/php '$WEBROOT/occ' upgrade --no-interaction"
    runuser www-data -s /bin/bash -c \
        "/usr/bin/php '$WEBROOT/occ' integrity:check-core"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
